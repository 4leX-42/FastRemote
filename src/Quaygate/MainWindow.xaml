<Window x:Class="Quaygate.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Quaygate" Icon="/Quaygate;component/Logo.png" WindowStyle="None" WindowStartupLocation="Manual" MinHeight="390" MinWidth="720" PreviewKeyDown="Keys">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="Frame" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Base}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>

 <!-- title bar -->
 <Grid Background="{DynamicResource Surface}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
   <Image Source="/Quaygate;component/Logo.png" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
   <TextBlock Text="Quaygate" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,1" VerticalAlignment="Center"/>
  </StackPanel>
  <Grid Grid.Column="1" Width="380" Height="28" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
   <TextBox x:Name="Search" Style="{StaticResource SearchField}" TextChanged="SearchChanged" AutomationProperties.Name="{DynamicResource LSearch}"/>
   <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource Sub}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <TextBlock x:Name="SearchHint" Text="{DynamicResource LSearch}" Foreground="{DynamicResource Sub}" FontSize="13" Margin="32,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
   <TextBlock Text="Ctrl+F" Foreground="{DynamicResource Sub}" FontSize="11" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.8"/>
  </Grid>
  <StackPanel Grid.Column="2" Orientation="Horizontal">
   <Button x:Name="BtnSettings" Tag="Settings" Content="&#xE713;" Click="ActionClick" ToolTip="{DynamicResource LSettings}" AutomationProperties.Name="{DynamicResource LSettings}" Style="{StaticResource Chrome}"/>
   <Rectangle Width="1" Height="16" Fill="{DynamicResource Line}" Margin="4,0"/>
   <Button x:Name="BtnMin" Tag="Minimize" Content="&#xE921;" Click="ActionClick" ToolTip="{DynamicResource LMinimize}" AutomationProperties.Name="{DynamicResource LMinimize}" Style="{StaticResource Chrome}"/>
   <Button x:Name="BtnMax" Tag="Maximize" Content="&#xE922;" Click="ActionClick" ToolTip="{DynamicResource LMaximize}" AutomationProperties.Name="{DynamicResource LMaximize}" Style="{StaticResource Chrome}"/>
   <Button x:Name="BtnClose" Tag="Close" Content="&#xE8BB;" Click="ActionClick" ToolTip="{DynamicResource LClose}" AutomationProperties.Name="{DynamicResource LClose}" Style="{StaticResource ChromeClose}"/>
  </StackPanel>
  <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Line}"/>
 </Grid>

 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>

  <!-- sites -->
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="14,12,6,8" LastChildFill="False">
     <TextBlock Text="{DynamicResource LSites}" Style="{StaticResource Section}" VerticalAlignment="Center"/>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
      <Button x:Name="BtnNew" Tag="New" Click="ActionClick" Content="&#xE710;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LNew}" AutomationProperties.Name="{DynamicResource LNew}"/>
      <Button x:Name="BtnImport" Tag="Import" Click="ActionClick" Content="&#xE896;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LImport}" AutomationProperties.Name="{DynamicResource LImport}"/>
      <Button x:Name="BtnBulk" Tag="Bulk" Click="ActionClick" Content="&#xE8D7;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LBulk}" AutomationProperties.Name="{DynamicResource LBulk}"/>
     </StackPanel>
    </DockPanel>
    <ListBox x:Name="Sites" SelectionChanged="SiteChanged" PreviewMouseRightButtonDown="SelectUnderMouse" ToolTip="{DynamicResource LDragHint}" ToolTipService.InitialShowDelay="1500">
     <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{DynamicResource Sub}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Border>

  <!-- connections -->
  <DockPanel Grid.Column="1">
   <DockPanel DockPanel.Dock="Top" Margin="22,14,20,6" LastChildFill="True">
    <TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="{DynamicResource Sub}" FontSize="12" VerticalAlignment="Center"/>
    <TextBlock x:Name="ListTitle" Style="{StaticResource Section}" VerticalAlignment="Center"/>
    <TextBlock x:Name="Info" Foreground="{DynamicResource Sub}" FontSize="12" Margin="14,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <Border DockPanel.Dock="Top" Margin="12,0,12,0" Padding="10,6,10,6" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
     <TextBlock Text="{DynamicResource LName}" Foreground="{DynamicResource Sub}" Grid.Column="1" FontSize="12"/><TextBlock Text="{DynamicResource LHost}" Foreground="{DynamicResource Sub}" Grid.Column="2" FontSize="12"/><TextBlock Text="{DynamicResource LUser}" Foreground="{DynamicResource Sub}" Grid.Column="3" FontSize="12"/></Grid>
   </Border>
   <Grid Margin="12,2,12,10"><ListBox x:Name="List" SelectionChanged="RowChanged" PreviewMouseRightButtonDown="SelectUnderMouse" MouseDoubleClick="RowDoubleClick"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
    <ListBox.ItemTemplate><DataTemplate><Grid Height="22"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
     <Ellipse Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource Line}"/><Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="Online"><Setter Property="Fill" Value="{DynamicResource Accent}"/></DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="Offline"><Setter Property="Fill" Value="#E27171"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
     <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBlock Grid.Column="2" Text="{Binding HostLabel}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="{DynamicResource Text}" VerticalAlignment="Center" Margin="0,0,8,0"/>
     <TextBlock Grid.Column="3" Text="{Binding Login}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="4" Text="{Binding KeyIcon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
    </Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <TextBlock x:Name="EmptyList" TextAlignment="Center" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center" Foreground="{DynamicResource Sub}"/></Grid>
  </DockPanel>

  <!-- details -->
  <Border Grid.Column="2" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Background="{DynamicResource Surface}" Padding="20,16,20,16">
   <Grid><TextBlock x:Name="NoSel" Text="{DynamicResource LSelect}" TextWrapping="Wrap" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    <DockPanel x:Name="Details">
     <StackPanel DockPanel.Dock="Bottom">
      <Button x:Name="BtnConnect" Content="{DynamicResource LConnect}" Tag="Connect" Click="ActionClick" Style="{StaticResource BtnGold}" HorizontalAlignment="Stretch"/>
      <UniformGrid Columns="5" Margin="0,10,0,0">
       <Button x:Name="BtnAdmin" Tag="Console" Click="ActionClick" Content="&#xE7F4;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LConsole}" AutomationProperties.Name="{DynamicResource LConsole}" HorizontalAlignment="Stretch"/>
       <Button x:Name="BtnFull" Tag="Full" Click="ActionClick" Content="&#xE740;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LFull}" AutomationProperties.Name="{DynamicResource LFull}" HorizontalAlignment="Stretch"/>
       <Button x:Name="BtnCred" Tag="Cred" Click="ActionClick" Content="&#xE8D7;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LCred}" AutomationProperties.Name="{DynamicResource LCred}" HorizontalAlignment="Stretch"/>
       <Button x:Name="BtnEdit" Tag="Edit" Click="ActionClick" Content="&#xE70F;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LEdit}" AutomationProperties.Name="{DynamicResource LEdit}" HorizontalAlignment="Stretch"/>
       <Button x:Name="BtnDel" Tag="Delete" Click="ActionClick" Content="&#xE74D;" Style="{StaticResource IconBtn}" ToolTip="{DynamicResource LDelete}" AutomationProperties.Name="{DynamicResource LDelete}" HorizontalAlignment="Stretch"/>
      </UniformGrid>
     </StackPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock x:Name="DSite" Style="{StaticResource Section}" Foreground="{DynamicResource Accent}"/>
      <TextBlock x:Name="DName" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,4"/>
      <TextBlock x:Name="DState" Foreground="{DynamicResource Sub}" FontSize="12"/>
      <TextBlock Text="{DynamicResource LHost}" Style="{StaticResource Caption}" Margin="0,22,0,3"/><TextBlock x:Name="DHost" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"/>
      <TextBlock Text="{DynamicResource LUser}" Style="{StaticResource Caption}"/><TextBlock x:Name="DUser" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource LCred}" Style="{StaticResource Caption}"/><TextBlock x:Name="DCred" TextWrapping="Wrap"/>
      <TextBlock Text="{DynamicResource LDescription}" Style="{StaticResource Caption}"/><TextBlock x:Name="DDescr" TextWrapping="Wrap"/>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Grid>
  </Border>
 </Grid>
 </Grid></Border>
</Window>
