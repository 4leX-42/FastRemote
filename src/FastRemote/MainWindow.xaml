<Window x:Class="FastRemote.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FastRemote" Icon="/FastRemote;component/Logo.png" WindowStyle="None" WindowStartupLocation="Manual" MinHeight="520" MinWidth="980" PreviewKeyDown="Keys">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <DataTemplate x:Key="CellName"><StackPanel Orientation="Horizontal">
   <TextBlock Text="{Binding KindIcon}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Sub}" Margin="0,0,10,0" ToolTip="{Binding KindText}"/>
   <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
   <Ellipse Width="6" Height="6" Fill="{DynamicResource Live}" Margin="8,1,0,0" VerticalAlignment="Center" ToolTip="{Binding SessionText}" Visibility="{Binding LiveVisibility}"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="CellHost"><TextBlock Text="{Binding HostLabel}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <DataTemplate x:Key="CellType"><Border Style="{StaticResource Badge}"><TextBlock Text="{Binding Protocol}" FontSize="11.5" Foreground="{DynamicResource Sub}"/></Border></DataTemplate>
  <DataTemplate x:Key="CellReach"><StackPanel Orientation="Horizontal" ToolTip="{Binding ReachTip}">
   <Ellipse Style="{StaticResource ReachDot}" Width="9" Height="9" Margin="0,1,8,0"/>
   <TextBlock Text="{Binding ReachText}" Style="{StaticResource ReachLabel}" VerticalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="CellSite"><TextBlock Text="{Binding SiteText}" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <DataTemplate x:Key="CellSession"><TextBlock Text="{Binding SessionText}" Style="{StaticResource SessionText}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <DataTemplate x:Key="CellUser"><TextBlock Text="{Binding Login}" TextTrimming="CharacterEllipsis"/></DataTemplate>
  <DataTemplate x:Key="CellLast"><TextBlock Text="{Binding LastText}"/></DataTemplate>
  <DataTemplate x:Key="CellLatency"><TextBlock Text="{Binding LatencyText}" Foreground="{DynamicResource Sub}"/></DataTemplate>
  <DataTemplate x:Key="CellCred"><TextBlock Text="{Binding KeyIcon}" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource Sub}" ToolTip="{Binding CredentialUser}"/></DataTemplate>
  <DataTemplate x:Key="CellStar"><Button Content="{Binding StarIcon}" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="13" Click="StarClick" Foreground="{Binding StarBrush}" ToolTip="{Binding StarTip}"/></DataTemplate>
 </Window.Resources>
 <Border x:Name="Frame" BorderThickness="1" BorderBrush="{DynamicResource Line}" Background="{DynamicResource Base}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>

 <!-- title bar with the menu -->
 <DockPanel Background="{DynamicResource Surface}">
  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
   <Button x:Name="BtnMin" Tag="Minimize" Content="&#xE921;" Click="ActionClick" ToolTip="{DynamicResource LMinimize}" AutomationProperties.Name="{DynamicResource LMinimize}" Style="{StaticResource Chrome}" Height="40"/>
   <Button x:Name="BtnMax" Tag="Maximize" Content="&#xE922;" Click="ActionClick" ToolTip="{DynamicResource LMaximize}" AutomationProperties.Name="{DynamicResource LMaximize}" Style="{StaticResource Chrome}" Height="40"/>
   <Button x:Name="BtnClose" Tag="Close" Content="&#xE8BB;" Click="ActionClick" ToolTip="{DynamicResource LClose}" AutomationProperties.Name="{DynamicResource LClose}" Style="{StaticResource ChromeClose}" Height="40"/>
  </StackPanel>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Image Source="{StaticResource LogoMark}" Width="22" Height="22" Margin="14,0,0,0"/>
   <TextBlock Text="FastRemote" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"/>
   <Rectangle Style="{StaticResource ToolSep}" Height="18" Margin="16,0,8,0"/>
   <Menu x:Name="MainMenu" VerticalAlignment="Center">
    <MenuItem Header="{DynamicResource LMenuFile}">
     <MenuItem Header="{DynamicResource LNew}" Tag="New" Click="ActionClick" InputGestureText="Ctrl+N"/>
     <MenuItem Header="{DynamicResource LImport}" Tag="Import" Click="ActionClick"/>
     <Separator/>
     <MenuItem Header="{DynamicResource LFolder}" Tag="OpenFolder" Click="ActionClick"/>
     <Separator/>
     <MenuItem Header="{DynamicResource LExit}" Tag="Close" Click="ActionClick" InputGestureText="Alt+F4"/>
    </MenuItem>
    <MenuItem x:Name="MenuView" Header="{DynamicResource LMenuView}" SubmenuOpened="ViewMenuOpened">
     <MenuItem x:Name="MSidebar" Header="{DynamicResource LSidebar}" Tag="Sidebar" Click="ActionClick" InputGestureText="Ctrl+B" IsCheckable="True"/>
     <MenuItem x:Name="MInspector" Header="{DynamicResource LDetailsPanel}" Tag="Inspector" Click="ActionClick" InputGestureText="Ctrl+I" IsCheckable="True"/>
     <MenuItem x:Name="MGroup" Header="{DynamicResource LGroupBySite}" Tag="Group" Click="ActionClick" IsCheckable="True"/>
     <MenuItem x:Name="MColumns" Header="{DynamicResource LColumns}"/>
     <MenuItem x:Name="MDensity" Header="{DynamicResource LDensity}">
      <MenuItem x:Name="MCompact" Header="{DynamicResource Lcompact}" Tag="Density:compact" Click="ActionClick" IsCheckable="True"/>
      <MenuItem x:Name="MComfortable" Header="{DynamicResource Lcomfortable}" Tag="Density:comfortable" Click="ActionClick" IsCheckable="True"/>
     </MenuItem>
     <Separator/>
     <MenuItem Header="{DynamicResource LPaletteMenu}" Tag="Palette" Click="ActionClick" InputGestureText="Ctrl+Shift+P"/>
    </MenuItem>
    <MenuItem x:Name="MenuConnections" Header="{DynamicResource LMenuConnections}" SubmenuOpened="ConnectionsMenuOpened">
     <MenuItem x:Name="MConnect" Header="{DynamicResource LOpenSession}" Tag="Connect" Click="ActionClick" InputGestureText="Enter"/>
     <MenuItem x:Name="MAdmin" Header="{DynamicResource LAdmin}" Tag="Admin" Click="ActionClick" InputGestureText="Ctrl+Enter"/>
     <MenuItem x:Name="MFull" Header="{DynamicResource LFull}" Tag="Full" Click="ActionClick" InputGestureText="Shift+Enter"/>
     <MenuItem x:Name="MAnother" Header="{DynamicResource LAnother}" Tag="Another" Click="ActionClick"/>
     <MenuItem x:Name="MDisconnect" Header="{DynamicResource LDisconnect}" Tag="Disconnect" Click="ActionClick"/>
     <MenuItem x:Name="MDisconnectAll" Header="{DynamicResource LDisconnectAll}" Tag="DisconnectAll" Click="ActionClick"/>
     <Separator/>
     <MenuItem Header="{DynamicResource LCheckAll}" Tag="CheckAll" Click="ActionClick" InputGestureText="F5"/>
     <Separator/>
     <MenuItem x:Name="MEdit" Header="{DynamicResource LEdit}" Tag="Edit" Click="ActionClick" InputGestureText="F2"/>
     <MenuItem x:Name="MDuplicate" Header="{DynamicResource LDuplicate}" Tag="Duplicate" Click="ActionClick" InputGestureText="Ctrl+D"/>
     <MenuItem x:Name="MFavorite" Header="{DynamicResource LFavorite}" Tag="Favorite" Click="ActionClick" InputGestureText="Ctrl+Shift+F"/>
     <MenuItem x:Name="MDelete" Header="{DynamicResource LDelete}" Tag="Delete" Click="ActionClick" InputGestureText="Supr"/>
    </MenuItem>
    <MenuItem Header="{DynamicResource LMenuTools}">
     <MenuItem Header="{DynamicResource LBulk}" Tag="Bulk" Click="ActionClick"/>
     <MenuItem x:Name="MCred" Header="{DynamicResource LCred}" Tag="Cred" Click="ActionClick"/>
     <Separator/>
     <MenuItem Header="{DynamicResource LSettings}" Tag="Settings" Click="ActionClick" InputGestureText="Ctrl+,"/>
    </MenuItem>
    <MenuItem Header="{DynamicResource LMenuHelp}">
     <MenuItem Header="{DynamicResource LKeyboard}" Tag="Shortcuts" Click="ActionClick"/>
     <MenuItem Header="{DynamicResource LAbout}" Tag="About" Click="ActionClick"/>
    </MenuItem>
   </Menu>
  </StackPanel>
 </DockPanel>

 <!-- toolbar -->
 <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="14,8">
  <DockPanel>
   <Button x:Name="SessionsButton" DockPanel.Dock="Right" Style="{StaticResource Outline}" Click="SessionsMenu" Padding="10,0" AutomationProperties.Name="{DynamicResource LLiveView}">
    <StackPanel Orientation="Horizontal">
     <TextBlock x:Name="SessionsIcon" Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Sub}" Margin="0,0,9,0"/>
     <TextBlock x:Name="SessionsText" VerticalAlignment="Center"/>
     <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="10,1,0,0" Foreground="{DynamicResource Sub}"/>
    </StackPanel>
   </Button>
   <StackPanel Orientation="Horizontal">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="3">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="BtnNew" Style="{StaticResource Tool}" Tag="New" Click="ActionClick" Padding="10,0" AutomationProperties.Name="{DynamicResource LNew}" ToolTip="Ctrl+N">
       <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource LBNew}" VerticalAlignment="Center"/></StackPanel></Button>
      <Rectangle Width="1" Fill="{DynamicResource Line}"/>
      <Button x:Name="BtnNewMore" Style="{StaticResource Tool}" Click="NewMenu" Content="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" MinWidth="28" AutomationProperties.Name="{DynamicResource LMore}"/>
     </StackPanel>
    </Border>
    <Rectangle Style="{StaticResource ToolSep}"/>
    <Button x:Name="BtnEditTool" Style="{StaticResource Tool}" Tag="Edit" Click="ActionClick" Content="&#xE70F;" FontFamily="{StaticResource Icons}" FontSize="15" ToolTip="{DynamicResource LEdit}" AutomationProperties.Name="{DynamicResource LEdit}"/>
    <Button x:Name="BtnDupTool" Style="{StaticResource Tool}" Tag="Duplicate" Click="ActionClick" Content="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="15" ToolTip="{DynamicResource LDuplicate}" AutomationProperties.Name="{DynamicResource LDuplicate}"/>
    <Button x:Name="BtnDelTool" Style="{StaticResource Tool}" Tag="Delete" Click="ActionClick" Content="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="15" ToolTip="{DynamicResource LDelete}" AutomationProperties.Name="{DynamicResource LDelete}"/>
    <Rectangle Style="{StaticResource ToolSep}"/>
    <TextBox x:Name="FilterBox" Style="{StaticResource SearchField}" Width="380" Height="32" Tag="{DynamicResource LSearchHint}" TextChanged="FilterChanged" AutomationProperties.Name="{DynamicResource LSearch}" AutomationProperties.AcceleratorKey="Ctrl+K"/>
    <Rectangle Style="{StaticResource ToolSep}"/>
    <Button x:Name="BtnConnectTool" Style="{StaticResource Tool}" Tag="Connect" Click="ActionClick" AutomationProperties.Name="{DynamicResource LOpenSession}" ToolTip="Enter">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/><TextBlock Text="{DynamicResource LBConnect}" VerticalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="BtnFullTool" Style="{StaticResource Tool}" Tag="Full" Click="ActionClick" AutomationProperties.Name="{DynamicResource LFull}" ToolTip="{DynamicResource LFull}">
     <TextBlock Text="&#xE740;" Style="{StaticResource Icon}" FontSize="15"/></Button>
    <Button x:Name="BtnMore" Style="{StaticResource Tool}" Click="MoreMenu" Content="&#xE712;" FontFamily="{StaticResource Icons}" FontSize="15" ToolTip="{DynamicResource LMore}" AutomationProperties.Name="{DynamicResource LMore}"/>
   </StackPanel>
  </DockPanel>
 </Border>

 <!-- one tab per open session: click to bring it forward, x to disconnect -->
 <Border x:Name="TabsBar" Grid.Row="2" Background="{DynamicResource Base}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Visibility="Collapsed">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="SessionTabs"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource SessionTab}" Click="TabClick" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Name}">
      <StackPanel Orientation="Horizontal">
       <Grid Margin="0,0,9,0" VerticalAlignment="Center"><TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Sub}"/>
        <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{DynamicResource Live}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-3,0"/></Grid>
       <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding Clock}" Foreground="{DynamicResource Sub}" FontSize="11.5" Margin="9,0,0,0" VerticalAlignment="Center"/>
       <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="22" Height="22" FontSize="9" Margin="10,0,0,0" Click="TabClose" ToolTip="{DynamicResource LDisconnect}" AutomationProperties.Name="{DynamicResource LDisconnect}"/>
      </StackPanel></Button>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding State}" Value="Interrupted"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Down}"/></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Connecting"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Sub}"/></DataTrigger>
      <DataTrigger Binding="{Binding State}" Value="Authenticating"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Checking}"/></DataTrigger>
     </DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>
 </Border>

 <Grid x:Name="Body" Grid.Row="3">
  <Grid.ColumnDefinitions><ColumnDefinition x:Name="SideColumn" Width="270"/><ColumnDefinition x:Name="SideSplitColumn" Width="5"/><ColumnDefinition Width="*" MinWidth="460"/><ColumnDefinition x:Name="SplitColumn" Width="5"/><ColumnDefinition x:Name="InspectorColumn" Width="400" MinWidth="0"/></Grid.ColumnDefinitions>

  <!-- navigation: views, then the site tree with its connections -->
  <DockPanel x:Name="Side" Background="{DynamicResource Surface}">
   <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,10">
    <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="14,0,14,8"/>
    <Button x:Name="NavCred" Style="{StaticResource NavButton}" Tag="Bulk" Click="ActionClick" AutomationProperties.Name="{DynamicResource LCredentials}" ToolTip="{DynamicResource LBulk}">
     <DockPanel Margin="14,0,12,0"><TextBlock Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,14,0"/>
      <TextBlock x:Name="CredCount" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Sub}" VerticalAlignment="Center"/>
      <TextBlock Text="{DynamicResource LCredentials}" VerticalAlignment="Center" FontSize="13.5"/></DockPanel>
    </Button>
    <Button x:Name="BtnSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="ActionClick" AutomationProperties.Name="{DynamicResource LSettings}">
     <DockPanel Margin="14,0,12,0"><TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,14,0"/>
      <TextBlock Text="{DynamicResource LSettings}" VerticalAlignment="Center" FontSize="13.5"/></DockPanel>
    </Button>
   </StackPanel>
   <ListBox x:Name="Nav" Margin="0,12,0,0" ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavChanged" PreviewMouseRightButtonDown="SelectUnderMouse" PreviewKeyDown="NavKeys" MouseDoubleClick="NavDoubleClick"
     AutomationProperties.Name="{DynamicResource LSites}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
    <ListBox.ItemTemplate><DataTemplate><Grid>
     <Grid x:Name="Head" Visibility="Collapsed" Margin="14,0,8,0">
      <Rectangle x:Name="Rule" Height="1" Fill="{DynamicResource Line}" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="Collapsed"/>
      <DockPanel VerticalAlignment="Bottom" Margin="0,0,0,4">
       <Button x:Name="HeadAction" DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource IconBtn}" Width="24" Height="24" FontSize="12" Tag="New" Click="ActionClick" ToolTip="{DynamicResource LNew}" Visibility="Collapsed" IsEnabled="True"/>
       <TextBlock Text="{Binding Label}" Style="{StaticResource Section}" FontSize="12" VerticalAlignment="Center"/>
      </DockPanel>
     </Grid>
     <DockPanel x:Name="Item" Margin="{Binding Indent}">
      <TextBlock x:Name="Chevron" Text="{Binding Chevron}" Style="{StaticResource Icon}" FontSize="9" Width="18" Foreground="{DynamicResource Sub}" MouseLeftButtonDown="ToggleNode" Background="Transparent"/>
      <TextBlock x:Name="Glyph" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" Width="20" Margin="0,0,12,0" Foreground="{Binding Tint}"/>
      <TextBlock x:Name="Count" DockPanel.Dock="Right" Text="{Binding Count}" FontSize="12.5" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="6,0,14,0"/>
      <Ellipse x:Name="Live" DockPanel.Dock="Right" Width="6" Height="6" Fill="{DynamicResource Live}" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="{Binding LiveVisibility}"/>
      <TextBlock x:Name="Text" Text="{Binding Label}" VerticalAlignment="Center" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
     </DockPanel></Grid>
     <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter TargetName="Head" Property="Visibility" Value="Visible"/><Setter TargetName="Item" Property="Visibility" Value="Collapsed"/></DataTrigger>
      <DataTrigger Binding="{Binding HeaderAction}" Value="True"><Setter TargetName="HeadAction" Property="Visibility" Value="Visible"/><Setter TargetName="Rule" Property="Visibility" Value="Visible"/></DataTrigger>
     </DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel>
  <GridSplitter x:Name="SideSplit" Grid.Column="1" Style="{StaticResource Splitter}" DragCompleted="SplitDone"/>

  <!-- connections -->
  <DockPanel Grid.Column="2">
   <DockPanel DockPanel.Dock="Top" Margin="20,14,16,8">
    <Button x:Name="BtnView" DockPanel.Dock="Right" Style="{StaticResource Outline}" Click="ViewButton" Padding="8,0" Height="30" ToolTip="{DynamicResource LMenuView}" AutomationProperties.Name="{DynamicResource LMenuView}">
     <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FD;" Style="{StaticResource Icon}" FontSize="14"/><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" Margin="8,1,0,0" Foreground="{DynamicResource Sub}"/></StackPanel></Button>
    <TextBlock x:Name="ViewTitle" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
   </DockPanel>
   <Grid Margin="10,0,8,0">
    <ListView x:Name="List" Style="{StaticResource Table}" ItemContainerStyle="{StaticResource TableRow}" SelectionChanged="RowChanged" PreviewMouseRightButtonDown="SelectUnderMouse" MouseDoubleClick="RowDoubleClick"
      AutomationProperties.Name="{DynamicResource LListTitle}"/>
    <TextBlock x:Name="EmptyList" TextAlignment="Center" TextWrapping="Wrap" Margin="12" VerticalAlignment="Center" Foreground="{DynamicResource Sub}" Visibility="Collapsed"/>
   </Grid>
  </DockPanel>
  <GridSplitter x:Name="InspectorSplit" Grid.Column="3" Style="{StaticResource Splitter}" DragCompleted="SplitDone"/>

  <!-- details of the selected connection -->
  <Border x:Name="Inspector" Grid.Column="4" Background="{DynamicResource Surface}">
   <Grid><TextBlock x:Name="NoSel" Text="{DynamicResource LSelect}" TextWrapping="Wrap" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"/>
    <DockPanel x:Name="Details" Margin="20,16,18,16">
     <DockPanel DockPanel.Dock="Top">
      <Button x:Name="BtnRowMenu" DockPanel.Dock="Right" Content="&#xE712;" Click="RowMenuButton" Style="{StaticResource IconBtn}" FontSize="14" ToolTip="{DynamicResource LMore}" AutomationProperties.Name="{DynamicResource LMore}" Margin="2,0,-6,0"/>
      <Button x:Name="BtnFav" DockPanel.Dock="Right" Tag="Favorite" Click="ActionClick" Style="{StaticResource IconBtn}" FontSize="15"/>
      <TextBlock x:Name="DKind" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource Sub}" Margin="0,0,14,0"/>
      <TextBlock x:Name="DName" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="ActionNote" Foreground="{DynamicResource Sub}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <!-- three actions of the same width -->
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Button x:Name="BtnEdit" Grid.Column="4" Style="{StaticResource Outline}" Tag="Edit" Click="ActionClick" Content="{DynamicResource LBEdit}" ToolTip="{DynamicResource LEdit}" Padding="10,0" Height="34"/>
       <Button x:Name="BtnDisconnect" Grid.Column="2" Style="{StaticResource Outline}" Click="ActionClick" Padding="10,0" Height="34"/>
       <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="3" Height="34">
        <DockPanel>
         <Button x:Name="BtnOpenMore" DockPanel.Dock="Right" Style="{StaticResource Tool}" Click="OpenMenu" Content="&#xE70D;" FontFamily="{StaticResource Icons}" FontSize="9" MinWidth="0" Width="24" Padding="0" Height="32" AutomationProperties.Name="{DynamicResource LMore}"/>
         <Rectangle DockPanel.Dock="Right" Width="1" Fill="{DynamicResource Accent}"/>
         <Button x:Name="BtnOpen" Style="{StaticResource Tool}" Click="ActionClick" Height="32" MinWidth="0" Padding="6,0" HorizontalContentAlignment="Center">
          <TextBlock x:Name="BtnOpenText" VerticalAlignment="Center" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/></Button>
        </DockPanel>
       </Border>
      </Grid>
     </StackPanel>
     <TabControl x:Name="InspectorTabs" Margin="0,14,0,0">
      <TabItem Header="{DynamicResource LGeneral}">
       <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
        <Grid x:Name="Props"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions></Grid>
        <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,8,0,14"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{DynamicResource LServiceState}" Style="{StaticResource Prop}" FontSize="13"/>
         <DockPanel Grid.Column="1">
          <Ellipse x:Name="DDot" Style="{StaticResource ReachDot}" Width="10" Height="10" Margin="0,4,10,0" VerticalAlignment="Top"/>
          <StackPanel><TextBlock x:Name="DReach" FontSize="14.5" FontWeight="SemiBold"/><TextBlock x:Name="DReachMeta" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
         </DockPanel>
        </Grid>
        <Rectangle Height="1" Fill="{DynamicResource Line}" Margin="0,14,0,14"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <TextBlock Text="{DynamicResource LSession}" Style="{StaticResource Prop}" FontSize="13"/>
         <DockPanel Grid.Column="1">
          <TextBlock x:Name="DSessionIcon" Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="15" Margin="0,1,10,0" VerticalAlignment="Top"/>
          <StackPanel><TextBlock x:Name="DSession" FontSize="14.5" FontWeight="SemiBold"/><TextBlock x:Name="DSessionMeta" Foreground="{DynamicResource Sub}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
         </DockPanel>
        </Grid>
        <Border x:Name="Diag" BorderBrush="{DynamicResource Down}" BorderThickness="2,0,0,0" Padding="10,2,0,2" Margin="0,16,0,0" Visibility="Collapsed">
         <StackPanel><TextBlock x:Name="DDiag" TextWrapping="Wrap"/><TextBlock x:Name="DDiagNote" Foreground="{DynamicResource Sub}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
        </Border>
       </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="{DynamicResource LSession}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="SessionPage"/></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource LMonitoring}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="MonitorPage"/></ScrollViewer></TabItem>
      <TabItem Header="{DynamicResource LNotes}">
       <DockPanel>
        <TextBlock x:Name="NotesState" DockPanel.Dock="Bottom" Foreground="{DynamicResource Sub}" FontSize="11.5" Margin="0,6,0,0"/>
        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" LostKeyboardFocus="NotesSave" AutomationProperties.Name="{DynamicResource LNotes}" MinHeight="140"/>
       </DockPanel>
      </TabItem>
     </TabControl>
    </DockPanel>
   </Grid>
  </Border>
 </Grid>

 <!-- status bar -->
 <Border Grid.Row="4" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,0,10,0">
  <DockPanel>
   <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Style="{StaticResource Tool}" Tag="CheckAll" Click="ActionClick" Height="26" Padding="6,0" ToolTip="F5" AutomationProperties.Name="{DynamicResource LCheckAll}">
    <StackPanel Orientation="Horizontal"><TextBlock x:Name="RefreshIcon" Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0" Foreground="{DynamicResource Sub}"/><TextBlock x:Name="LastCheck" FontSize="12.5" VerticalAlignment="Center"/></StackPanel>
   </Button>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource Up}" Margin="0,1,8,0" VerticalAlignment="Center"/>
    <TextBlock x:Name="StatusTotal" FontSize="12.5"/>
    <Rectangle Style="{StaticResource ToolSep}" Height="14" Margin="14,0"/>
    <TextBlock x:Name="StatusUp" FontSize="12.5"/>
    <Rectangle Style="{StaticResource ToolSep}" Height="14" Margin="14,0"/>
    <TextBlock x:Name="StatusDown" FontSize="12.5"/>
    <Rectangle x:Name="StatusLiveSep" Style="{StaticResource ToolSep}" Height="14" Margin="14,0"/>
    <TextBlock x:Name="StatusLive" FontSize="12.5" Foreground="{DynamicResource Live}"/>
    <TextBlock x:Name="Summary" FontSize="12.5" Foreground="{DynamicResource Sub}" Margin="24,0,0,0" TextTrimming="CharacterEllipsis"/>
   </StackPanel>
  </DockPanel>
 </Border>

 <!-- command palette (Ctrl+Shift+P): an overlay inside the window, never a second window -->
 <Grid x:Name="Palette" Grid.RowSpan="5" Visibility="Collapsed">
  <Rectangle Fill="{DynamicResource Backdrop}" MouseLeftButtonDown="PaletteOutside"/>
  <Border Width="640" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,64,0,0" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
   <DockPanel>
    <TextBox x:Name="PaletteText" DockPanel.Dock="Top" Style="{StaticResource PaletteBox}" Tag="{DynamicResource LPaletteHint}" TextChanged="PaletteChanged" PreviewKeyDown="PaletteKeys" AutomationProperties.Name="{DynamicResource LPalette}"/>
    <Rectangle DockPanel.Dock="Top" Height="1" Fill="{DynamicResource Line}"/>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,7"><TextBlock x:Name="PaletteFoot" Foreground="{DynamicResource Sub}" FontSize="11.5"/></Border>
    <Grid MaxHeight="430">
     <ListBox x:Name="PaletteList" ItemContainerStyle="{StaticResource PaletteItem}" Margin="0,6" MouseLeftButtonUp="PaletteClick" Focusable="False" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Grid>
       <TextBlock x:Name="Head" Text="{Binding Title}" Style="{StaticResource Section}" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed"/>
       <DockPanel x:Name="Item">
        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Width="20" Foreground="{Binding Tint}" Margin="0,0,12,0"/>
        <Border DockPanel.Dock="Right" Style="{StaticResource Key}" x:Name="KeyBox"><TextBlock Text="{Binding Hint}" FontSize="11" Foreground="{DynamicResource Sub}"/></Border>
        <TextBlock Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Sub}" FontSize="12" Margin="12,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
       </DockPanel></Grid>
       <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsHeader}" Value="True"><Setter TargetName="Head" Property="Visibility" Value="Visible"/><Setter TargetName="Item" Property="Visibility" Value="Collapsed"/></DataTrigger>
        <DataTrigger Binding="{Binding Hint}" Value=""><Setter TargetName="KeyBox" Property="Visibility" Value="Collapsed"/></DataTrigger>
       </DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock x:Name="PaletteEmpty" Foreground="{DynamicResource Sub}" Margin="20,18" Visibility="Collapsed"/>
    </Grid>
   </DockPanel>
  </Border>
 </Grid>
 </Grid></Border>
</Window>
