<Window x:Class="FastRemote.Dialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" SizeToContent="Height" Width="475" MinWidth="300">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="40" ResizeBorderThickness="4" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border x:Name="Frame" Padding="17" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Base}">
 <DockPanel><TextBlock x:Name="Heading" DockPanel.Dock="Top" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
 <StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="DlgError" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,5"/>
 <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="DlgCancel" Content="{DynamicResource LBCancel}" IsCancel="True" MinWidth="88" Height="32"/>
 <Button x:Name="DlgOk" Content="{DynamicResource LBOK}" Style="{StaticResource BtnGold}" Click="Accept" IsDefault="True" Margin="0" MinWidth="88" Height="32"/></StackPanel></StackPanel>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Body" Margin="0,0,6,0"/></ScrollViewer>
 </DockPanel></Border>
</Window>
